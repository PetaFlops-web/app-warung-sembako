generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER // Pemilik Warung
  KEEPER // Penjaga Warung
}

enum StockStatus {
  NORMAL // stok > batas minimum
  LOW // 0 < stok <= batas minimum (menipis)
  OUT_OF_STOCK // stok = 0 (habis)
}

enum InventoryType {
  TRACKED // stok dipantau (default)
  NOT_TRACKED // stok tidak dipantau
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  username  String
  email     String   @unique
  password  String
  role      Role     @default(KEEPER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @unique
  categoryId    String        @db.Uuid
  unit          String
  sellingPrice  Int
  stockQuantity Decimal       @default(0) @db.Decimal(10, 3)
  minStock      Decimal       @default(0) @db.Decimal(10, 3)
  stockStatus   StockStatus   @default(NORMAL)
  inventoryType InventoryType @default(TRACKED)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category Category @relation(fields: [categoryId], references: [id])

  @@map("products")
}
