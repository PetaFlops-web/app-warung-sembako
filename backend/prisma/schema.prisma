generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER // Pemilik Warung
  KEEPER // Penjaga Warung
}

enum InventoryType {
  TRACKED // stok dipantau (default)
  NOT_TRACKED // stok tidak dipantau
}

enum MovementType {
  INITIAL // stok awal saat produk dibuat
  IN // barang masuk
  OUT // barang keluar
  ADJUSTMENT // penyesuaian stok manual oleh Pemilik
}

// Catatan: model User/RefreshToken/AIUsageHistory belum mengikuti SRS 4.1
// (masih id Int, belum ada username/is_active) karena 8 baris data dev sudah ada.
// Konversi users ke UUID dipisah ke task tersendiri.
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(KEEPER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       Product[]
  stockMovements StockMovement[]
  aiUsageHistory AIUsageHistory[]
  refreshTokens  RefreshToken[]
}

// Kategori produk (SRS 4.1)
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

// Produk warung (SRS 4.1). Status stok TIDAK disimpan, dihitung dari stock & minStock.
model Product {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  categoryId    String        @db.Uuid
  category      Category      @relation(fields: [categoryId], references: [id])
  unit          String        @default("pcs")
  price         Int
  stock         Decimal       @default(0) @db.Decimal(10, 3)
  minStock      Decimal       @default(0) @db.Decimal(10, 3)
  inventoryType InventoryType @default(TRACKED)
  imageId       String?
  imageUrl      String?
  isDeleted     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  stockMovements StockMovement[]
  restockItems   RestockItem[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

// Mencatat setiap perubahan stok (stok awal, masuk, keluar, atau penyesuaian)
model StockMovement {
  id          String       @id @default(uuid()) @db.Uuid
  type        MovementType
  quantity    Decimal      @db.Decimal(10, 3)
  stockBefore Decimal      @db.Decimal(10, 3)
  stockAfter  Decimal      @db.Decimal(10, 3)
  note        String?
  createdAt   DateTime     @default(now())

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([productId, createdAt])
  @@map("stock_movements")
}

// Daftar produk yang perlu diisi ulang (stok menipis atau habis).
// Kolom status/reason/closed_at (SRS 4.1) ditambahkan saat modul restock dikerjakan.
model RestockItem {
  id           String   @id @default(uuid()) @db.Uuid
  suggestedQty Decimal? @db.Decimal(10, 3)
  addedAt      DateTime @default(now())
  updatedAt    DateTime @updatedAt

  productId String  @unique @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  @@map("restock_items")
}

// Riwayat percakapan dengan AI Assistant (Gemini)
model AIUsageHistory {
  id        Int      @id @default(autoincrement())
  question  String
  response  String
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])
}

// Token penyegaran (refresh token) aktif per pengguna; mendukung rotasi dan pencabutan
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
